<Window x:Class="OC_Swapper.AuthorSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OC_Swapper"
        mc:Ignorable="d"
        Title="OC Swapper - Author Settings" Height="150" Width="550" Padding="20">
    <Grid Loaded="Window_Loaded">
        <Label Content="Open Composite File Location:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
       
        <TextBox Name="TxtOpenCompositeStorageFolder" HorizontalAlignment="Left" Margin="187,14,0,0" TextWrapping="NoWrap" Text="..." VerticalAlignment="Top" Width="250" IsReadOnly="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <Label Content="Steam VR File Location:" HorizontalAlignment="Left" Margin="49,33,0,0" VerticalAlignment="Top"/>
       
        <TextBox x:Name="TxtSteamVrStorageFolder" HorizontalAlignment="Left" Margin="187,37,0,0" TextWrapping="NoWrap" Text="..." VerticalAlignment="Top" Width="250" IsReadOnly="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <Label Content="Path to DLL to swap:" HorizontalAlignment="Left" Margin="64,56,0,0" VerticalAlignment="Top"/>
       
        <TextBox x:Name="TxtOpenVrDllFilePath" HorizontalAlignment="Left" Margin="187,60,0,0" TextWrapping="NoWrap" Text="..." VerticalAlignment="Top" Width="250" IsReadOnly="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        
        <Button x:Name="BtnOpenCompositeFileLocation" Content="Select" HorizontalAlignment="Left" Margin="442,13,0,0" VerticalAlignment="Top"/>
        <Button x:Name="BtnSteamVrStorageFolder" Content="Select" HorizontalAlignment="Left" Margin="442,36,0,0" VerticalAlignment="Top"/>
        <Button x:Name="BtnOpenVrDllFilePath" Content="Select" HorizontalAlignment="Left" Margin="442,59,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
