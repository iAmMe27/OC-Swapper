<Window x:Class="OC_Swapper.AuthorSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OC_Swapper"
        mc:Ignorable="d"
        Title="OC Swapper - Author Settings" Height="250" Width="550" Padding="20">
    <Grid Loaded="Window_Loaded">
        <TextBox Name="TxtOpenCompositeStorageFolder" HorizontalAlignment="Left" Margin="187,20,0,0" TextWrapping="NoWrap" Text="..." VerticalAlignment="Top" Width="250" IsReadOnly="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <Label Content="Open Composite File Location:" HorizontalAlignment="Left" Margin="10,15,0,0" VerticalAlignment="Top"/>
        
        <TextBox x:Name="TxtSteamVrStorageFolder" HorizontalAlignment="Left" Margin="187,80,0,0" TextWrapping="NoWrap" Text="..." VerticalAlignment="Top" Width="250" IsReadOnly="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <Label Content="Steam VR File Location:" HorizontalAlignment="Left" Margin="49,75,55,0" VerticalAlignment="Top"/>
       
        <TextBox x:Name="TxtOpenVrDllFilePath" HorizontalAlignment="Left" Margin="187,140,0,0" TextWrapping="NoWrap" Text="..." VerticalAlignment="Top" Width="250" IsReadOnly="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <Label Content="Path to DLL to swap:" HorizontalAlignment="Left" Margin="64,135,0,0" VerticalAlignment="Top"/>
       
        <Button x:Name="BtnOpenCompositeFileLocation" Content="Select" HorizontalAlignment="Left" Margin="442,20,0,0" VerticalAlignment="Top" Click="BtnOpenCompositeFileLocation_OnClick"/>
        <Button x:Name="BtnSteamVrStorageFolder" Content="Select" HorizontalAlignment="Left" Margin="442,80,0,0" VerticalAlignment="Top" Click="BtnSteamVrStorageFolder_OnClick"/>
        <Button x:Name="BtnOpenVrDllFilePath" Content="Select" HorizontalAlignment="Left" Margin="442,140,0,0" VerticalAlignment="Top" Click="BtnOpenVrDllFilePath_OnClick"/>

    </Grid>
</Window>
